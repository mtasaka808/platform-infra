{
  "title": "CDM Platform Overview",
  "uid": "cdm-platform",
  "schemaVersion": 38,
  "panels": [
    {
      "title": "Request Rate — grants-mgmt-api",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rate(istio_requests_total{destination_service=~\"grants-mgmt-api.*\"}[5m])) by (response_code)"
      }]
    },
    {
      "title": "P99 Latency — grants-mgmt-api",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "histogram_quantile(0.99, sum(rate(istio_request_duration_milliseconds_bucket{destination_service=~\"grants-mgmt-api.*\"}[5m])) by (le))"
      }]
    },
    {
      "title": "Active Grant Events (RabbitMQ)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rabbitmq_queue_messages{queue=~\"app.grants.*\"})"
      }]
    },
    {
      "title": "Pod Restarts",
      "type": "table",
      "gridPos": { "x": 6, "y": 8, "w": 18, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum by (pod) (kube_pod_container_status_restarts_total{namespace=~\"cdm.*\"}) > 0"
      }]
    },
    {
      "title": "Logs — grants-mgmt-api (ERROR)",
      "type": "logs",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "targets": [{
        "datasource": "Loki",
        "expr": "{app_kubernetes_io_name=\"grants-mgmt-api\"} |= \"ERROR\""
      }]
    }
  ]
}
